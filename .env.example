# Wolt Drive — kredencijali koje izdaje Wolt kad se potpiše ugovor.
#
# Ove promenljive se čitaju SAMO na serveru (u /api funkcijama). Nikada ih ne
# stavljajte u promenljivu koja počinje sa VITE_ — to bi ih ugradilo u JS koji
# se šalje pregledaču i token bi bio javan.
#
# Dok su prazne, sajt radi u TEST REŽIMU: cene dostave su simulirane, nijedan
# kurir se ne šalje, i checkout to jasno prikazuje korisniku.

# Bearer token. Wolt daje dev token na početku integracije, a produkcioni tek
# kad prođete njihovo testiranje.
WOLT_API_TOKEN=

# ID lokala (venue) koji Wolt podešava u svojim alatima za vašu radnju.
WOLT_VENUE_ID=

# Menjajte samo ako vam Wolt da drugačiji host (npr. zaseban sandbox).
WOLT_API_BASE=https://daas-public-api.wolt.com
